# ==============================================================
# Pixcraft Studio — Environment Configuration Example
# ==============================================================
# All local image operations (cropping, composer, compression, color grading)
# work 100% offline out-of-the-box without any environment variables.
# ==============================================================

# Optional: Cloud Provider API Keys (for remote fallback integration)
ILOVEAPI_PUBLIC_KEY=
ILOVEAPI_SECRET_KEY=

# Optional: AI Enhancements (Gemini Vision / Models)
GEMINI_API_KEY=

# Optional: Custom Canonical Site URL (for SEO / OpenGraph metadata)
PIXCRAFT_SITE_URL=https://pixcraft-studio.vercel.app

# Port for local dev server (default: 3000)
PORT=3000
